# Database Configuration
DATABASE_URL=postgresql://cveuser:cvepass@postgres:5432/cvedb

# OpenSearch Configuration
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_ADMIN_PASS=StrongPassw0rd!

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# NVD API Configuration
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=bf7031e3-132a-4411-98d2-2edc5e0e5c57
NVD_RESULTS_PER_PAGE=2000
NVD_MAX_RETRIES=3
NVD_RETRY_DELAY=1
NVD_DAYS_BACK=7
NVD_HISTORICAL_START_YEAR=1999
NVD_INITIAL_LOAD=false
NVD_INTERVAL_SECONDS=60
# How often to run a full round (hours)
NVD_FULL_ROUND_HOURS=6
# Size of the incremental sliding window in minutes
NVD_INCREMENTAL_WINDOW_MINUTES=60

# CISA API Configuration
CISA_API_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
CISA_MAX_RETRIES=3
CISA_RETRY_DELAY=5

# General Ingestion Settings (backward compatibility)
RESULTS_PER_PAGE=2000
MAX_RETRIES=3
RETRY_DELAY=5

# Logging
LOG_LEVEL=DEBUG
# Presentation timezone for API responses
APP_TIMEZONE=Asia/Kuala_Lumpur

AUTH_ISSUER=http://localhost:8001/
AUTH_JWKS_URL=http://localhost:8001/.well-known/jwks.json

