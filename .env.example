# Core DB
DATABASE_URL=postgresql://cveuser:cvepass@postgres:5432/cvedb

# Auth service integration
# Public base URL or issuer of your auth service (used for token verification)
AUTH_ISSUER=http://192.168.21.31:8001
# Optionally enforce audience claim
# JWT_AUDIENCE=api://tis-api
# Optionally override JWKS URL (defaults to ${AUTH_ISSUER}/.well-known/jwks.json)
# AUTH_JWKS_URL=

# Internal IP allowlist for non-public endpoints (e.g., /admin)
# Comma-separated path prefixes to protect (default is "/admin")
# INTERNAL_PROTECTED_PREFIXES=/admin
# Comma-separated IPs or CIDRs allowed to access protected paths. Empty = allow all.
# INTERNAL_IP_ALLOWLIST=127.0.0.1/32,192.168.0.0/16,10.0.0.0/8
# Trust proxy headers (X-Forwarded-For / X-Real-IP). Set true only when behind a trusted proxy.
# INTERNAL_TRUST_FORWARD_HEADERS=false

# API
API_HOST=0.0.0.0
API_PORT=8000

# Ingestion tuning (optional)
NVD_INTERVAL_SECONDS=60
NVD_FULL_ROUND_HOURS=6
NVD_INCREMENTAL_WINDOW_MINUTES=60

# Timezone for presented timestamps
APP_TIMEZONE=Asia/Kuala_Lumpur